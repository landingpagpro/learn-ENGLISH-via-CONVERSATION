# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional comma-separated backup keys for automatic quota rotation.
GEMINI_API_KEYS=""

# APP_URL / FREE_APP_URL / CUSTOM_DOMAIN: Preserved automatically at runtime.
APP_URL="MY_APP_URL"
FREE_APP_URL=""
CUSTOM_DOMAIN=""
