{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/logos/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/logos",
      "destination": "/logos/index.html"
    },
    {
      "source": "/logos/",
      "destination": "/logos/index.html"
    },
    {
      "source": "/((?!api/|assets/|logos/).*)",
      "destination": "/index.html"
    }
  ]
}
